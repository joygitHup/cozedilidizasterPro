# Django
DJANGO_SECRET_KEY=change-me-in-production
# 现场 / 生产必须 False
DEBUG=False

# 生产务必设置：
# ALLOWED_HOSTS=your.domain,127.0.0.1
# CORS_ALLOW_ALL=false
# CORS_ALLOWED_ORIGINS=https://your.domain
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOW_ALL=false
CORS_ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
CSRF_TRUSTED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000

# 数据库: sqlite | postgres
# 本机开发默认 sqlite；接现场 Postgres 时改为 postgres 并核对账号
DB_ENGINE=sqlite

# PostgreSQL（DB_ENGINE=postgres 时生效；须与现场实例账号一致）
DB_NAME=geohazard
DB_USER=geohazard_user
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=5432
DB_CONN_MAX_AGE=60

# 时序存储: postgres | influxdb（推荐 Docker）| tdengine
TSDB_BACKEND=influxdb
# 外部时序开启时是否双写 Postgres（预警引擎 / Celery 日聚合兼容）
TSDB_DUAL_WRITE=true

# InfluxDB 2：docker compose up -d influxdb
INFLUXDB_URL=http://127.0.0.1:8086
INFLUXDB_TOKEN=geohazard-influx-dev-token
INFLUXDB_ORG=geohazard
INFLUXDB_BUCKET=monitor
INFLUXDB_USER=admin
INFLUXDB_PASSWORD=geohazard_influx
INFLUXDB_PORT=8086

# 可选 TDengine（TSDB_BACKEND=tdengine）
# TDENGINE_HOST=127.0.0.1
# TDENGINE_PORT=6030
# TDENGINE_USER=root
# TDENGINE_PASSWORD=Taostaos@123
# TDENGINE_DB=geohazard_monitor

# Redis
REDIS_URL=redis://127.0.0.1:6379/3
REDIS_IGNORE_EXCEPTIONS=true
REDIS_KEY_PREFIX=geohazard

# 网关：Django 限流/审计（Nginx 示例见 deploy/nginx/geohazard.conf）
# 开发(DEBUG)默认关闭限流；生产请设 GATEWAY_RATE_LIMIT_ENABLED=true
GATEWAY_RATE_LIMIT_ENABLED=true
# 开发也要测限流时再开：GATEWAY_RATE_LIMIT_FORCE=true
GATEWAY_API_RATE_LIMIT=1200
GATEWAY_API_RATE_WINDOW=60
GATEWAY_LOGIN_RATE_LIMIT=30
GATEWAY_LOGIN_RATE_WINDOW=60
# 前置 Nginx/LB 时再开，并配合 set_real_ip_from
GATEWAY_TRUST_X_FORWARDED=false
GATEWAY_AUDIT_ENABLED=true
GATEWAY_AUDIT_DB=true
# true=审计全部 API GET；默认仅写操作 + 4xx/5xx
GATEWAY_AUDIT_ALL=false

# JWT（小时）
JWT_ACCESS_HOURS=12
JWT_REFRESH_DAYS=7

# IoT：桥接 → Django ingest
# 生产必须更换 Token；可用 MQTT_INGEST_TOKENS=new,old 做轮换
MQTT_INGEST_TOKEN=dev-mqtt-ingest-token
# MQTT_INGEST_TOKENS=
# 默认强制鉴权；仅本地无 Token 联调时可 true（切勿上现场）
MQTT_INGEST_ALLOW_DEBUG_BYPASS=false
# 建议限制为 bridge 所在机器：MQTT_INGEST_ALLOW_IPS=127.0.0.1,::1
MQTT_INGEST_ALLOW_IPS=
MQTT_INGEST_RATE_LIMIT=120
MQTT_INGEST_RATE_WINDOW=60
IOT_ONLINE_TTL_SECONDS=180
CELERY_BROKER_URL=redis://127.0.0.1:6379/4
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/4
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
# 多 bridge 实例时设同一组：MQTT_SHARE_GROUP=geohazard
MQTT_SHARE_GROUP=
# 落盘缓冲目录（转发失败时）
# MQTT_BRIDGE_SPOOL_DIR=services/mqtt_bridge/spool

# 前端代理后端：单体直连 :8000；微服务模式改网关 :8088
BACKEND_URL=http://127.0.0.1:8000
DJANGO_INGEST_URL=http://127.0.0.1:8000/api/monitoring/ingest/mqtt/

# 微服务（scripts/start-microservices.ps1；并设 USE_MICROSERVICES=1）
# CORE:8000  MONITOR:8001  WARNING:8002  GATEWAY:8088
# BACKEND_URL=http://127.0.0.1:8088
# DJANGO_INGEST_URL=http://127.0.0.1:8088/api/monitoring/ingest/mqtt/
# 微服务进程间鉴权（Monitor → Warning /internal/*）
INTERNAL_SERVICE_TOKEN=geohazard-internal-dev
# 可选独立库（默认与 CORE 同一 Postgres）
# MONITOR_DATABASE_URL=postgresql+psycopg://user:pass@127.0.0.1:5432/geohazard_monitor
# WARNING_DATABASE_URL=postgresql+psycopg://user:pass@127.0.0.1:5432/geohazard_warning
USE_MICROSERVICES=0
CORE_PORT=8000
MONITOR_PORT=8001
WARNING_PORT=8002
GATEWAY_PORT=8088
CORE_SERVICE_URL=http://127.0.0.1:8000
MONITOR_SERVICE_URL=http://127.0.0.1:8001
WARNING_SERVICE_URL=http://127.0.0.1:8002

# Mapbox（转移避险路线/安置点地图；在 https://account.mapbox.com 申请）
# 通知通道（一键叫应）
# SMS_PROVIDER=auto|webhook|aliyun|required|console
# SMS_WEBHOOK_URL=
# VOICE_WEBHOOK_URL=
# VOICE_PROVIDER=auto
# 未配置真实网关时叫应计为失败；仅本地演示可：NOTIFY_ALLOW_CONSOLE=true
# NOTIFY_ALLOW_CONSOLE=false
# ALIYUN_SMS_ACCESS_KEY_ID=
# ALIYUN_SMS_GATEWAY_URL=
# ALIYUN_SMS_SIGN_NAME=地质灾害
# ALIYUN_SMS_TEMPLATE_CODE=
# NOTIFY_WEBHOOK_TOKEN=
# EMAIL_WEBHOOK_URL=
# EMAIL_PROVIDER=auto|required|console
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# SMTP_TLS=1
# APP_PUSH_WEBHOOK_URL=
# APP_PUSH_PROVIDER=auto|required

# 天气（Open-Meteo，无需 Key）
# WEATHER_LAT=30.67
# WEATHER_LNG=104.06
# WEATHER_CACHE_SEC=1800

# 转移路线：mapbox|osrm|auto（默认 auto：Mapbox→OSRM→插值）
# ROUTE_PROVIDER=auto
# MAPBOX_ACCESS_TOKEN=
# MAPBOX_DIRECTIONS_PROFILE=walking
# OSRM_BASE_URL=https://router.project-osrm.org
# OSRM_PROFILE=foot

NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=
# NEXT_PUBLIC_CESIUM_ION_TOKEN=

# 独立视频服务（MediaMTX HLS 反代 + 摄像头目录）
VIDEO_SERVICE_URL=http://127.0.0.1:8600
VIDEO_PORT=8600
MEDIAMTX_RTSP_URL=rtsp://127.0.0.1:8554
MEDIAMTX_HLS_URL=http://127.0.0.1:8888
MEDIAMTX_WHEP_URL=http://127.0.0.1:8889

# 附件微服务（MinIO S3）— scripts/start-storage.ps1
# 默认复用本机已有 MinIO :9000（Admin/Admin123）；或 docker compose --profile minio up -d
STORAGE_SERVICE_URL=http://127.0.0.1:8700
STORAGE_PORT=8700
STORAGE_PUBLIC_BASE=/storage-api
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=Admin
MINIO_SECRET_KEY=Admin123
MINIO_BUCKET=geohazard
# 可选 Cesium Ion token（无则使用 OSM 底图）
# NEXT_PUBLIC_CESIUM_ION_TOKEN=

# 端口
PORT=5000
BACKEND_PORT=8000
